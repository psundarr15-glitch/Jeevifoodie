cd ~/food && cat > app/Views/delivery/order_details.php << 'PHPEOF'
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Details — Jeevi Delivery</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="<?= base_url('assets/css/style.css') ?>" rel="stylesheet">
</head>
<body style="background:#f7f7f8;">
<div class="container" style="max-width: 520px;">

    <div class="order-details-header">
        <a href="<?= base_url('delivery/dashboard') ?>"><i class="bi bi-arrow-left"></i></a>
        <h5>Order Details</h5>
    </div>

    <?php if (session()->getFlashdata('success')): ?>
        <div class="alert alert-success"><?= esc(session()->getFlashdata('success')) ?></div>
    <?php endif; ?>
    <?php if (session()->getFlashdata('error')): ?>
        <div class="alert alert-danger"><?= esc(session()->getFlashdata('error')) ?></div>
    <?php endif; ?>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <span class="badge bg-secondary">#<?= esc($order['order_code']) ?> — <?= order_status_label($order['order_status']) ?></span>
        <?php if ($distance_km !== null): ?>
            <span class="distance-chip"><i class="bi bi-signpost-2"></i> <?= esc($distance_km) ?> km away</span>
        <?php endif; ?>
    </div>

    <!-- Store Details -->
    <?php
        $restDest = null;
        if ($restaurant['lat'] && $restaurant['lng']) {
            $restDest = $restaurant['lat'] . ',' . $restaurant['lng'];
        } elseif ($restaurant['address']) {
            $restDest = urlencode($restaurant['address']);
        }
    ?>
    <div class="detail-card">
        <div class="section-label">Store Details</div>
        <div class="party-name"><?= esc($restaurant['name']) ?></div>
        <div class="party-address"><?= esc($restaurant['address'] ?: 'Address not available') ?></div>
        <div class="contact-actions">
            <?php if ($restaurant['phone']): ?>
                <a href="tel:<?= esc($restaurant['phone']) ?>"><i class="bi bi-telephone-fill"></i> Call</a>
                <a href="sms:<?= esc($restaurant['phone']) ?>"><i class="bi bi-chat-dots-fill"></i> Chat</a>
            <?php endif; ?>
            <?php if ($restDest): ?>
                <a class="direction-link" href="https://www.google.com/maps/dir/?api=1&destination=<?= $restDest ?>" target="_blank"><i class="bi bi-signpost-split-fill"></i> Direction</a>
            <?php endif; ?>
        </div>
    </div>

    <!-- Customer Contact Details -->
    <?php
        $customerDest = null;
        if ($address) {
            if ($address['lat'] && $address['lng']) {
                $customerDest = $address['lat'] . ',' . $address['lng'];
            } else {
                $customerDest = urlencode($address['address_line'] . ', ' . $address['city'] . ', ' . $address['state'] . ' ' . $address['pincode']);
            }
        }
    ?>
    <div class="detail-card">
        <div class="section-label">Customer Contact Details</div>
        <div class="party-name"><?= esc($order['customer_name']) ?></div>
        <?php if ($address): ?>
            <div class="party-address">
                <?= esc($address['address_line']) ?>, <?= esc($address['city']) ?>, <?= esc($address['state']) ?> <?= esc($address['pincode']) ?>
            </div>
        <?php else: ?>
            <div class="party-address">No delivery address on file.</div>
        <?php endif; ?>
        <div class="contact-actions">
            <a href="tel:<?= esc($order['customer_phone']) ?>"><i class="bi bi-telephone-fill"></i> Call</a>
            <a href="sms:<?= esc($order['customer_phone']) ?>"><i class="bi bi-chat-dots-fill"></i> Chat</a>
            <?php if ($customerDest): ?>
                <a class="direction-link" href="https://www.google.com/maps/dir/?api=1&destination=<?= $customerDest ?>" target="_blank"><i class="bi bi-signpost-split-fill"></i> Direction</a>
            <?php endif; ?>
        </div>
    </div>

    <!-- Items -->
    <div class="detail-card">
        <div class="section-label">Items</div>
        <?php foreach ($items as $it): ?>
            <div class="order-item-row">
                <div>
                    <div class="item-name"><?= esc($it['item_name']) ?></div>
                    <div class="item-price">₹<?= esc($it['price']) ?></div>
                </div>
                <div class="item-qty">
                    Quantity: <strong><?= (int)$it['quantity'] ?></strong><br>
                    <span class="diet-tag <?= $it['is_veg'] ? 'veg' : 'nonveg' ?> mt-1 d-inline-block"><?= $it['is_veg'] ? 'Veg' : 'Non Veg' ?></span>
                </div>
            </div>
        <?php endforeach; ?>
    </div>

    <!-- Bill Details -->
    <div class="detail-card">
        <div class="section-label">Bill Details</div>
        <div class="bill-row"><span>Item Price</span><span>₹<?= number_format($order['subtotal'], 2) ?></span></div>
        <div class="bill-row"><span>Addons</span><span>(+) ₹0.00</span></div>
        <div class="bill-row"><strong>Subtotal</strong><strong>₹<?= number_format($order['subtotal'], 2) ?></strong></div>
        <div class="bill-row"><span>Discount</span><span>(-) ₹<?= number_format($order['discount'], 2) ?></span></div>
        <div class="bill-row"><span>Delivery Fee</span><span>(+) ₹<?= number_format($order['delivery_fee'], 2) ?></span></div>
        <div class="bill-row"><span>Deliveryman Tips</span><span>(+) ₹0.00</span></div>
        <div class="bill-row total"><span>Total</span><span>₹<?= number_format($order['total'], 2) ?></span></div>
    </div>

    <?php if ($order['delivery_partner_id'] === null && $order['order_status'] === 'placed'): ?>
        <div class="detail-card d-flex gap-2">
            <form method="post" action="<?= base_url('delivery/orders/' . $order['id'] . '/reject') ?>" class="flex-grow-1">
                <?= csrf_field() ?>
                <button type="submit" class="btn btn-outline-danger w-100">Reject</button>
            </form>
            <form method="post" action="<?= base_url('delivery/orders/' . $order['id'] . '/accept') ?>" class="flex-grow-1">
                <?= csrf_field() ?>
                <button type="submit" class="btn btn-jeevi w-100">Accept</button>
            </form>
        </div>
    <?php elseif (! in_array($order['order_status'], ['delivered', 'cancelled'])): ?>
        <form method="post" action="<?= base_url('delivery/orders/' . $order['id'] . '/update-status') ?>" class="detail-card d-flex gap-2 align-items-center">
            <?= csrf_field() ?>
            <select name="order_status" class="form-select">
                <?php foreach (['confirmed', 'preparing', 'out_for_delivery', 'delivered'] as $s): ?>
                    <option value="<?= $s ?>" <?= $order['order_status'] === $s ? 'selected' : '' ?>><?= order_status_label($s) ?></option>
                <?php endforeach; ?>
            </select>
            <button type="submit" class="btn btn-jeevi">Update Status</button>
        </form>
    <?php endif; ?>

</div>
</body>
</html>
PHPEOF