<?= $this->extend('admin/layouts/main') ?>
<?= $this->section('content') ?>

<a href="<?= base_url('admin/chat') ?>" class="small d-inline-block mb-3"><i class="bi bi-arrow-left"></i> Back to Live Chat</a>
<h4 class="section-title mb-4">Chat with <?= esc($customer['name']) ?></h4>

<div class="card card-jeevi p-3">
    <div id="adminChatThread" style="height: 420px; overflow-y: auto;" class="mb-3 px-2">
        <?php foreach ($messages as $m): ?>
            <div class="d-flex mb-2 <?= $m['sender'] === 'support' ? 'justify-content-end' : 'justify-content-start' ?>">
                <div class="p-2 px-3 rounded-3 <?= $m['sender'] === 'support' ? 'bg-danger text-white' : 'bg-light' ?>" style="max-width: 70%;">
                    <?= esc($m['message']) ?>
                    <div class="small <?= $m['sender'] === 'support' ? 'text-white-50' : 'text-muted' ?>" style="font-size: .68rem;"><?= esc($m['created_at']) ?></div>
                </div>
            </div>
        <?php endforeach; ?>
    </div>
    <form id="adminChatForm" class="d-flex gap-2">
        <input type="text" id="adminChatInput" class="form-control" placeholder="Type a reply…" autocomplete="off">
        <button type="submit" class="btn btn-jeevi">Send</button>
    </form>
</div>

<?= $this->endSection() ?>

<script>
const customerId = <?= (int) $customer['id'] ?>;
const thread = document.getElementById('adminChatThread');
const form = document.getElementById('adminChatForm');
const input = document.getElementById('adminChatInput');

function scrollToBottom() { thread.scrollTop = thread.scrollHeight; }
scrollToBottom();

function renderMessages(messages) {
    thread.innerHTML = messages.map(m => `
        <div class="d-flex mb-2 ${m.sender === 'support' ? 'justify-content-end' : 'justify-content-start'}">
            <div class="p-2 px-3 rounded-3 ${m.sender === 'support' ? 'bg-danger text-white' : 'bg-light'}" style="max-width: 70%;">
                ${m.message}
                <div class="small ${m.sender === 'support' ? 'text-white-50' : 'text-muted'}" style="font-size: .68rem;">${m.created_at ?? ''}</div>
            </div>
        </div>
    `).join('');
    scrollToBottom();
}

async function poll() {
    try {
        const res = await fetch(`<?= base_url('admin/chat/') ?>${customerId}/fetch`);
        const data = await res.json();
        if (data.messages) renderMessages(data.messages);
    } catch (e) { /* ignore transient network errors */ }
}
setInterval(poll, 4000);

form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const message = input.value.trim();
    if (! message) return;
    input.value = '';
    try {
        await fetch(`<?= base_url('admin/chat/') ?>${customerId}/send`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'message=' + encodeURIComponent(message) + '&<?= csrf_token() ?>=<?= csrf_hash() ?>'
        });
        poll();
    } catch (e) { /* ignore */ }
});
</script>
