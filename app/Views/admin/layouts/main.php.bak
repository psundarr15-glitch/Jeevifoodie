<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><?= $title ?? 'Jeevi Admin' ?></title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Main CSS -->
    <link href="<?= base_url('assets/css/style.css') ?>" rel="stylesheet">

    <style>
        :root {
            --jeevi-red: #e63946;
            --jeevi-red-dark: #c92f3b;
            --sidebar-bg: #111827;
            --sidebar-hover: #1f2937;
            --sidebar-text: #9ca3af;
            --sidebar-active: #ffffff;
            --page-bg: #f5f7fb;
            --border-color: #e5e7eb;
        }

        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            background: var(--page-bg);
            font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont,
                         "Segoe UI", sans-serif;
            color: #1f2937;
        }

        /* =========================
           SIDEBAR
        ========================= */

        .admin-wrapper {
            min-height: 100vh;
        }

        .admin-sidebar {
            width: 255px;
            min-height: 100vh;
            background: var(--sidebar-bg);
            position: fixed;
            left: 0;
            top: 0;
            bottom: 0;
            z-index: 1050;
            display: flex;
            flex-direction: column;
            box-shadow: 4px 0 20px rgba(0, 0, 0, .08);
            transition: .3s ease;
        }

        /* Logo */

        .sidebar-logo {
            height: 75px;
            padding: 18px 22px;
            display: flex;
            align-items: center;
            border-bottom: 1px solid rgba(255,255,255,.07);
        }

        .sidebar-logo img {
            max-height: 38px;
            max-width: 175px;
            object-fit: contain;
        }

        .brand-text {
            color: #fff;
            font-size: 20px;
            font-weight: 800;
            letter-spacing: .4px;
        }

        .brand-subtitle {
            display: block;
            color: #6b7280;
            font-size: 10px;
            margin-top: -2px;
            letter-spacing: 1px;
        }

        /* Navigation */

        .sidebar-menu {
            flex: 1;
            padding: 18px 12px;
            overflow-y: auto;
        }

        .menu-title {
            color: #6b7280;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            padding: 0 12px;
            margin: 8px 0 10px;
        }

        .admin-sidebar a {
            color: var(--sidebar-text);
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 11px 13px;
            margin: 4px 0;
            text-decoration: none;
            border-radius: 10px;
            font-size: 14px;
            font-weight: 500;
            transition: all .2s ease;
            position: relative;
        }

        .admin-sidebar a i {
            width: 20px;
            text-align: center;
            font-size: 17px;
            transition: .2s ease;
        }

        .admin-sidebar a:hover {
            background: var(--sidebar-hover);
            color: #fff;
            transform: translateX(2px);
        }

        .admin-sidebar a:hover i {
            color: var(--jeevi-red);
        }

        .admin-sidebar a.active {
            background: linear-gradient(
                135deg,
                var(--jeevi-red),
                var(--jeevi-red-dark)
            );
            color: #fff;
            box-shadow: 0 6px 16px rgba(230,57,70,.25);
        }

        .admin-sidebar a.active i {
            color: #fff;
        }

        /* Sidebar Footer */

        .sidebar-footer {
            padding: 14px 12px;
            border-top: 1px solid rgba(255,255,255,.07);
        }

        .admin-user {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px;
            margin-bottom: 8px;
            background: rgba(255,255,255,.04);
            border-radius: 10px;
        }

        .admin-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--jeevi-red);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 14px;
        }

        .admin-user-name {
            color: #fff;
            font-size: 13px;
            font-weight: 600;
        }

        .admin-user-role {
            color: #6b7280;
            font-size: 10px;
            margin-top: 1px;
        }

        .logout-link {
            color: #f87171 !important;
        }

        .logout-link:hover {
            background: rgba(239,68,68,.1) !important;
            color: #fca5a5 !important;
        }

        /* =========================
           MAIN CONTENT
        ========================= */

        .admin-main {
            margin-left: 255px;
            min-height: 100vh;
            transition: .3s ease;
        }

        .topbar {
            height: 75px;
            background: #fff;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 28px;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .page-heading {
            font-size: 18px;
            font-weight: 700;
            color: #111827;
            margin: 0;
        }

        .page-subtitle {
            font-size: 12px;
            color: #9ca3af;
            margin-top: 2px;
        }

        .mobile-menu-btn {
            width: 40px;
            height: 40px;
            border: 0;
            border-radius: 9px;
            background: #f3f4f6;
            color: #374151;
            display: none;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .content-area {
            padding: 28px;
        }

        /* =========================
           ALERTS
        ========================= */

        .alert {
            border: 0;
            border-radius: 12px;
            padding: 13px 16px;
            font-size: 14px;
            box-shadow: 0 4px 14px rgba(0,0,0,.04);
        }

        .alert-success {
            background: #ecfdf3;
            color: #166534;
        }

        .alert-danger {
            background: #fef2f2;
            color: #991b1b;
        }

        /* =========================
           MOBILE OVERLAY
        ========================= */

        .sidebar-overlay {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,.45);
            z-index: 1040;
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 991px) {

            .admin-sidebar {
                transform: translateX(-100%);
            }

            .admin-sidebar.show {
                transform: translateX(0);
            }

            .admin-main {
                margin-left: 0;
            }

            .mobile-menu-btn {
                display: flex;
            }

            .sidebar-overlay.show {
                display: block;
            }

            .topbar {
                padding: 0 18px;
            }

            .content-area {
                padding: 20px 16px;
            }
        }

        @media (max-width: 576px) {

            .topbar {
                height: 65px;
            }

            .page-heading {
                font-size: 16px;
            }

            .page-subtitle {
                display: none;
            }

            .content-area {
                padding: 16px 12px;
            }
        }
    </style>
</head>

<body>

